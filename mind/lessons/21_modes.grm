set {name}_sc5 = 1 when {here} and {name}_cyc in 0.5 .. 1.5
set {name}_sc7 = 1 when {here} and {name}_cyc in 0.5 .. 1.5
set {name}_sc9 = 1 when {here} and {name}_cyc in 0.5 .. 1.5
set {name}_sc10 = 1 when {here} and {name}_cyc in 0.5 .. 1.5
repeat p in 0 .. 11: set {name}_ct{p} = 0 when {here} and {name}_cyc in 0.5 .. 1.5
set {name}_ct0 = 1 when {here} and {name}_cyc in 0.5 .. 1.5
set {name}_ct4 = 1 when {here} and {name}_cyc in 0.5 .. 1.5
set {name}_ct7 = 1 when {here} and {name}_cyc in 0.5 .. 1.5
set {name}_root = 0 when {here} and {name}_cyc in 0.5 .. 1.5
repeat p in 0 .. 11: set {name}_sc{p} = 0 when {here} and {name}_cyc in 1.5 .. 2.5
