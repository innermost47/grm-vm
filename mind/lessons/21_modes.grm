set {name}_sc5 = 1 when {here} and {name}_cyc in 2.5 .. 3.5
set {name}_sc7 = 1 when {here} and {name}_cyc in 2.5 .. 3.5
set {name}_sc8 = 1 when {here} and {name}_cyc in 2.5 .. 3.5
set {name}_sc10 = 1 when {here} and {name}_cyc in 2.5 .. 3.5
