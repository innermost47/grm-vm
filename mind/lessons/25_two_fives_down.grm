# Lesson: ii-V's down by whole tones
# Leçon : des ii-V qui descendent par tons
# iim7 V7, then the same a tone lower, and lower.
repeat k in 1 .. 16: set {name}_open{k} = 1 when {here}
set {name}_breathw = 0.6 when {here}
set {name}_moving = 1 when {here}
set {name}_modul = 10 when {here}
set {name}_chords = 1 when {here}
set {name}_chordal = 1 when {here}
set {name}_blen = 2 when {here}
repeat p in 0 .. 11: set {name}_sc{p} = 0 when {here}
set {name}_sc0 = 1 when {here}
set {name}_sc2 = 1 when {here}
set {name}_sc4 = 1 when {here}
set {name}_sc5 = 1 when {here}
set {name}_sc7 = 1 when {here}
set {name}_sc9 = 1 when {here}
set {name}_sc11 = 1 when {here}
repeat p in 0 .. 11: set {name}_ct{p} = 0 when {here} and {name}_bar in -0.5 .. 0.5
set {name}_ct0 = 1 when {here} and {name}_bar in -0.5 .. 0.5
set {name}_ct2 = 1 when {here} and {name}_bar in -0.5 .. 0.5
set {name}_ct5 = 1 when {here} and {name}_bar in -0.5 .. 0.5
set {name}_ct9 = 1 when {here} and {name}_bar in -0.5 .. 0.5
set {name}_root = 2 when {here} and {name}_bar in -0.5 .. 0.5
repeat p in 0 .. 11: set {name}_ct{p} = 0 when {here} and {name}_bar in 0.5 .. 1.5
set {name}_ct2 = 1 when {here} and {name}_bar in 0.5 .. 1.5
set {name}_ct5 = 1 when {here} and {name}_bar in 0.5 .. 1.5
set {name}_ct7 = 1 when {here} and {name}_bar in 0.5 .. 1.5
set {name}_ct11 = 1 when {here} and {name}_bar in 0.5 .. 1.5
set {name}_root = 7 when {here} and {name}_bar in 0.5 .. 1.5
