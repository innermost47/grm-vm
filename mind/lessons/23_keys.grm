# Lesson: the key moves
# Leçon : la tonalité bouge
# I vi IV V, the key moving each form: a fifth, a fourth, a semitone, a third.
repeat k in 1 .. 16: set {name}_open{k} = 1 when {here}
set {name}_breathw = 0.6 when {here}
set {name}_moving = 1 when {here}
set {name}_chords = 1 when {here}
set {name}_chordal = 1 when {here}
repeat p in 0 .. 11: set {name}_sc{p} = 0 when {here}
set {name}_sc0 = 1 when {here}
set {name}_sc2 = 1 when {here}
set {name}_sc4 = 1 when {here}
set {name}_sc5 = 1 when {here}
set {name}_sc7 = 1 when {here}
set {name}_sc9 = 1 when {here}
set {name}_sc11 = 1 when {here}
repeat p in 0 .. 11: set {name}_ct{p} = 0 when {here} and {name}_bar in -0.5 .. 0.5
set {name}_ct0 = 1 when {here} and {name}_bar in -0.5 .. 0.5
set {name}_ct4 = 1 when {here} and {name}_bar in -0.5 .. 0.5
set {name}_ct7 = 1 when {here} and {name}_bar in -0.5 .. 0.5
set {name}_root = 0 when {here} and {name}_bar in -0.5 .. 0.5
repeat p in 0 .. 11: set {name}_ct{p} = 0 when {here} and {name}_bar in 0.5 .. 1.5
set {name}_ct0 = 1 when {here} and {name}_bar in 0.5 .. 1.5
set {name}_ct4 = 1 when {here} and {name}_bar in 0.5 .. 1.5
set {name}_ct9 = 1 when {here} and {name}_bar in 0.5 .. 1.5
set {name}_root = 9 when {here} and {name}_bar in 0.5 .. 1.5
repeat p in 0 .. 11: set {name}_ct{p} = 0 when {here} and {name}_bar in 1.5 .. 2.5
set {name}_ct0 = 1 when {here} and {name}_bar in 1.5 .. 2.5
set {name}_ct5 = 1 when {here} and {name}_bar in 1.5 .. 2.5
set {name}_ct9 = 1 when {here} and {name}_bar in 1.5 .. 2.5
set {name}_root = 5 when {here} and {name}_bar in 1.5 .. 2.5
repeat p in 0 .. 11: set {name}_ct{p} = 0 when {here} and {name}_bar in 2.5 .. 3.5
set {name}_ct2 = 1 when {here} and {name}_bar in 2.5 .. 3.5
set {name}_ct7 = 1 when {here} and {name}_bar in 2.5 .. 3.5
set {name}_ct11 = 1 when {here} and {name}_bar in 2.5 .. 3.5
set {name}_root = 7 when {here} and {name}_bar in 2.5 .. 3.5
set {name}_modul = 7 when {here} and {name}_cyc in -0.5 .. 0.5
set {name}_modul = 5 when {here} and {name}_cyc in 0.5 .. 1.5
set {name}_modul = 1 when {here} and {name}_cyc in 1.5 .. 2.5
set {name}_modul = 4 when {here} and {name}_cyc in 2.5 .. 3.5
