# Her, as she plays: her mood (pleasure, surprise, uncertainty, boredom, curiosity, what she hears clearly), her
# key (one given, or hers), whether she has lessons, and what she wants to play next (fifteen intervals and a rest,
# the one she chose lit). Her nodes are elle_...
#   use widgets/her.grm
#   widget her: her_band at 0 1

kind her_band: column size 12 3
  widget mood: row size 12 1
    widget pleasure: meter elle_pleasure -1 .. 1 size 2 1 "pleasure"
    widget surprise: meter elle_sur 0 .. 1 size 2 1 "surprise"
    widget unsure: meter elle_unc 0 .. 1 size 2 1 "uncertainty"
    widget bored: meter elle_bore 0 .. 1 size 2 1 "boredom"
    widget curious: meter elle_curious -0.3 .. 0.3 size 2 1 "curiosity"
    widget clear: meter elle_clar 0 .. 0.5 size 2 1 "heard clearly"
  end
  widget choose: row size 12 2
    widget lessons: toggle elle_lessons_on size 2 1 "lessons" tip "she learns lesson after lesson"
    widget key: choice elle_key_pick size 3 1 "key: hers=-1|key: A=0|key: Bb=1|key: B=2|key: C=3|key: C#=4|key: D=5|key: Eb=6|key: E=7|key: F=8|key: F#=9|key: G=10|key: Ab=11" tip "a key given to her, or hers"
    widget wants: bars elle_choice elle_want1 elle_want2 elle_want3 elle_want4 elle_want5 elle_want6 elle_want7 elle_want8 elle_want9 elle_want10 elle_want11 elle_want12 elle_want13 elle_want14 elle_want15 elle_want16 size 4 2 "what she wants" tip "-7 .. +7 semitones, and a rest: the one she chose lit"
  end
end
