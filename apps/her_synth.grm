app Her synth
# Her own synthesiser: the same as the human's (the same voices, the same knobs), but hers. Only she plays it and
# turns its knobs (the human sees them move; only its loudness stays theirs, and its sound on or off); she never
# touches the human's. Each their instrument, listening to each other: she hears both, and plays with what the human
# plays. A little to the right in the stereo, the human's a little to the left. Its tempo is the human's.
# An analogue synthesiser of four voices, every module a network (nothing ready-made): each voice three oscillators
# (saw, square, a sine that can modulate the others: FM), a filter of four poles with its resonance, two envelopes, an
# amplifier; an LFO; an echo and a reverb made of delays; and a sequencer of eight steps, a network apart, that can
# drive the first voice instead of the keys.
# The keys: a pitch (Hz) and a gate (held or not).
input pitch = 220 positive
input hold = 0
# The sequencer: on or off, its tempo (in beats a minute: a step is an eighth, two a beat), the pitch of each of its
# eight steps.
input seq_on = 0
# This instrument is hers.
input hers = 1
input bpm = 104 positive
node steps
relate eighths: steps = 0.0333333333 * bpm
node seq_rate signed
relate seq_speed: seq_rate = 0.0000208333333 * steps
input s_n1 = 110 positive
input s_n2 = 165 positive
input s_n3 = 220 positive
input s_n4 = 110 positive
input s_n5 = 147 positive
input s_n6 = 220 positive
input s_n7 = 196 positive
input s_n8 = 131 positive
use networks/sequencer.grm
call sequencer(name=s, rate=seq_rate)
# What plays: the keys, or the sequencer when it is on.
node note signed
relate choose: note = pitch + seq_on * s_pitch - seq_on * pitch
node gate signed
relate open: gate = hold + seq_on * s_gate
# The LFO: a slow wave (its speed in Hz, its shape from smooth to square), and how much it moves the filter, the
# pitch (a vibrato) and the loudness (a tremolo).
input lfo_rate = 4 positive
input lfo_shape = 0
input lfo_cut = 0
input lfo_pitch = 0
input lfo_amp = 0
node lfo_step signed
relate lfo_speed: lfo_step = 0.0000833333333 * lfo_rate
use networks/lfo.grm
call lfo(name=lfo, step=lfo_step, shape=lfo_shape)
# The metronome: a click at each beat (the first of the bar louder), on or off, how loud; its phase says where the
# beat is (she learns to play on it).
input metro_on = 0
input metro_level = 0.3
node mt_step
relate beat_speed: mt_step = 0.000000347222222 * bpm
use networks/metronome.grm
call metronome(name=mt, step=mt_step)
input volume = 0.4 positive
# The tremolo and the volume: what each voice's loudness is multiplied by; the vibrato: what its pitch is.
node trem signed
relate tremolo: trem = volume - 0.5 * lfo_amp * volume - 0.5 * lfo_amp * volume * lfo_out
node vib signed
relate vibrato: vib = 1 + lfo_pitch * lfo_out
# The oscillators, each voice its three: 1 and 2 a saw or a square (shape), 2 tuned by its ratio; 3 a sine that is
# heard and moves the pitch of 1 and 2 (FM).
input shape = 0
input o1_level = 1
input o2_level = 0
input o2_ratio = 1.005 positive
input o3_level = 0
input o3_ratio = 2 positive
input fm = 0
# Drums: noise (a snare, a hi-hat), and how much the filter's envelope raises the pitch as a note begins (a kick).
input noise = 0
input pitch_env = 0
# Two full envelopes (attack, decay, sustain, release): one opens the filter, one shapes the loudness. Their times
# in seconds, as a musician turns them (up: longer); each becomes the rate the envelope moves at each sample
# (rate x time = 1 / 48 000).
input fa_time = 0.01 positive
input fd_time = 0.3 positive
input f_sustain = 0.3
input fr_time = 0.2 positive
input aa_time = 0.005 positive
input ad_time = 0.4 positive
input a_sustain = 0.7
input ar_time = 0.3 positive
node f_attack
relate fa_rate: f_attack * fa_time = 0.0000208333333
node f_decay
relate fd_rate: f_decay * fd_time = 0.0000208333333
node f_release
relate fr_rate: f_release * fr_time = 0.0000208333333
node a_attack
relate aa_rate: a_attack * aa_time = 0.0000208333333
node a_decay
relate ad_rate: a_decay * ad_time = 0.0000208333333
node a_release
relate ar_rate: a_release * ar_time = 0.0000208333333
# The filter: how open (the LFO opens and closes it, multiplied: never below nothing), how much each voice's
# envelope opens it more, how much it sings.
input cutoff = 0.06 positive
input env_amount = 0.2
input resonance = 1
node cut_now signed
relate cut_lfo: cut_now = cutoff + lfo_cut * cutoff * lfo_out
# Four voices, one synthesiser (polyphonic): the first plays the keys or the sequencer (her bass, when she plays),
# the second her melody, the third and fourth her chords; a key the human holds takes a voice (a hand of hers).
input poly = 4
input lead_pitch = 440 positive
input lead_gate = 0
input c1_pitch = 330 positive
input c1_gate = 0
input c2_pitch = 392 positive
input c2_gate = 0
use networks/saw.grm
use networks/square.grm
use networks/ladder.grm
use networks/adsr.grm
use networks/noise.grm
use networks/voice.grm
call voice(name=v1, pitch=note, gate=gate, vib=vib, shape=shape, l1=o1_level, l2=o2_level, r2=o2_ratio, l3=o3_level, r3=o3_ratio, fm=fm, cut=cut_now, env=env_amount, res=resonance, fa=f_attack, fd=f_decay, fs=f_sustain, fr=f_release, aa=a_attack, ad=a_decay, as=a_sustain, ar=a_release, amp=trem, noise=noise, penv=pitch_env, seed=0.31)
call voice(name=v2, pitch=lead_pitch, gate=lead_gate, vib=vib, shape=shape, l1=o1_level, l2=o2_level, r2=o2_ratio, l3=o3_level, r3=o3_ratio, fm=fm, cut=cut_now, env=env_amount, res=resonance, fa=f_attack, fd=f_decay, fs=f_sustain, fr=f_release, aa=a_attack, ad=a_decay, as=a_sustain, ar=a_release, amp=trem, noise=noise, penv=pitch_env, seed=0.37)
call voice(name=v3, pitch=c1_pitch, gate=c1_gate, vib=vib, shape=shape, l1=o1_level, l2=o2_level, r2=o2_ratio, l3=o3_level, r3=o3_ratio, fm=fm, cut=cut_now, env=env_amount, res=resonance, fa=f_attack, fd=f_decay, fs=f_sustain, fr=f_release, aa=a_attack, ad=a_decay, as=a_sustain, ar=a_release, amp=trem, noise=noise, penv=pitch_env, seed=0.41)
call voice(name=v4, pitch=c2_pitch, gate=c2_gate, vib=vib, shape=shape, l1=o1_level, l2=o2_level, r2=o2_ratio, l3=o3_level, r3=o3_ratio, fm=fm, cut=cut_now, env=env_amount, res=resonance, fa=f_attack, fd=f_decay, fs=f_sustain, fr=f_release, aa=a_attack, ad=a_decay, as=a_sustain, ar=a_release, amp=trem, noise=noise, penv=pitch_env, seed=0.43)
node vca signed
relate amp: vca = v1_out + v2_out + v3_out + v4_out
# The echo (a third of a second) and the room.
input echo_back = 0.35
use networks/echo.grm
call echo(name=dl, input=vca, time=0.33, feedback=echo_back)
input room = 0.7
use networks/reverb.grm
call reverb(name=rv, input=dl_wet, decay=room)
input wet = 0.3
# The effects on or off (an on/off node: 1 or 0).
input fx_on = 1
# Improvising by ear: 1, she writes the sequencer's next notes herself, by what she hears of them.
input auto_on = 0
# The arpeggiator: on, the keys held (or her chord) are played one after another on the first voice: up, down,
# up and down, or at random (its mode, 0 .. 3), over one to three octaves, so many notes a step of the sequencer.
input arp_on = 0
input arp_mode = 0
input arp_oct = 1 positive
input arp_rate = 1 positive
# Exact notes: 1, a step moved by hand lands on a semitone; 0, anywhere between.
input seq_exact = 1
node fx signed
relate effects: fx = fx_on * dl_wet + fx_on * wet * rv_out - fx_on * vca
# In stereo: this synthesiser a little to the right (the human's a little to the left); each voice a little apart (the first to the left, the second to the right, the chords nearer the
# middle), so that what does what can be told apart; the effects in the middle.
node out signed
relate left: out = 0.39 * v1_out + 0.21 * v2_out + 0.33 * v3_out + 0.27 * v4_out + 0.42 * fx + metro_on * metro_level * mt_out
node out_r signed
relate right: out_r = 0.35 * v1_out + 0.65 * v2_out + 0.45 * v3_out + 0.55 * v4_out + 0.7 * fx + metro_on * metro_level * mt_out
# Its surface, as a desk: sections, small knobs each with its name and sign, switches with their light, the
# steps of the sequencer with their notes. The sections come first: they are drawn under the rest.
icon audio-waveform
widget s1: section at 0 0 size 8 3 "oscillators" icon audio-waveform
widget s2: section at 8 0 size 4 3 "filter" icon funnel
widget s4: section at 0 3 size 6 3 "filter envelope" icon activity
widget s5: section at 6 3 size 6 3 "amp envelope" icon activity
widget s6: section at 0 6 size 6 3 "effects" icon waves
widget s3: section at 6 6 size 6 3 "output" icon volume-2
widget s9: section at 0 9 size 12 3 "lfo" icon audio-lines
widget s8: section at 0 12 size 12 7 "sequencer · arpeggiator" icon layout-grid
widget sh: knob shape 0 .. 1 at 0 1 size 1 2 "saw · square" icon audio-waveform
widget l1: knob o1_level 0 .. 1 at 1 1 size 1 2 "osc 1"
widget l2: knob o2_level 0 .. 1 at 2 1 size 1 2 "osc 2"
widget r2: knob o2_ratio 0.25 .. 4 at 3 1 size 1 2 "2: tune"
widget l3: knob o3_level 0 .. 1 at 4 1 size 1 2 "osc 3 (sine)"
widget r3: knob o3_ratio 0.5 .. 8 at 5 1 size 1 2 "3: ratio"
widget fm: knob fm 0 .. 1 at 6 1 size 1 2 "fm" icon zap
widget nz: knob noise 0 .. 1 at 7 1 size 1 2 "noise" icon audio-lines
widget cu: knob cutoff 0.005 .. 0.32 at 8 1 size 2 2 "cutoff" icon funnel
widget ea: knob env_amount 0 .. 0.3 at 10 1 size 1 2 "env" icon activity
widget re: knob resonance 0 .. 3.5 at 11 1 size 1 2 "resonance" icon radio
widget fa: knob fa_time 0.001 .. 4 at 0 4 size 1 2 "attack"
widget fd: knob fd_time 0.001 .. 4 at 1 4 size 1 2 "decay"
widget fs: knob f_sustain 0 .. 1 at 2 4 size 1 2 "sustain"
widget fr: knob fr_time 0.001 .. 4 at 3 4 size 1 2 "release"
widget pe: knob pitch_env 0 .. 4 at 4 4 size 2 2 "to the pitch" icon music
widget aa: knob aa_time 0.001 .. 4 at 6 4 size 1 2 "attack"
widget ad: knob ad_time 0.001 .. 4 at 7 4 size 2 2 "decay"
widget as: knob a_sustain 0 .. 1 at 9 4 size 1 2 "sustain"
widget ar: knob ar_time 0.001 .. 4 at 10 4 size 2 2 "release"
widget fx: switch fx_on at 0 7 size 2 1 "on" icon power
widget ec: knob echo_back 0 .. 0.9 at 2 7 size 1 2 "echo" icon repeat
widget ro: knob room 0 .. 0.97 at 3 7 size 2 2 "room" icon box
widget we: knob wet 0 .. 1 at 5 7 size 1 2 "reverb" icon waves
widget wave: scope out -1 .. 1 at 6 7 size 3 2 "heard"
widget vo: knob volume 0.01 .. 1 at 9 7 size 1 2 "volume" icon volume-2
widget go: play out at 10 7 size 2 1 "sound"
widget rc: rec at 10 8 size 2 1 "rec"
widget lr: knob lfo_rate 0.05 .. 12 at 0 10 size 2 2 "speed" icon timer
widget lh: knob lfo_shape 0 .. 1 at 2 10 size 2 2 "smooth · square" icon audio-waveform
widget lc: knob lfo_cut 0 .. 0.5 at 4 10 size 3 2 "to the filter" icon funnel
widget lp: knob lfo_pitch 0 .. 0.03 at 7 10 size 2 2 "vibrato" icon music
widget la: knob lfo_amp 0 .. 1 at 9 10 size 3 2 "tremolo" icon volume-2
widget sq: switch seq_on at 0 13 size 2 1 "on" icon power
widget au: switch auto_on at 0 14 size 2 1 "by ear" icon ear
widget tp: knob bpm 30 .. 240 at 0 15 size 1 2 "bpm" icon timer
widget ml: knob metro_level 0 .. 1 at 1 15 size 1 2 "click"
widget mo: switch metro_on at 0 17 size 2 1 "metronome" icon metronome
widget ex: switch seq_exact at 10 13 size 2 1 "exact notes" icon magnet
widget ar1: switch arp_on at 10 14 size 2 1 "arpeggiator" icon list-music
widget ar2: knob arp_rate 0.25 .. 4 at 10 15 size 1 2 "speed"
widget ar3: knob arp_oct 1 .. 3 at 11 15 size 1 2 "octaves"
widget ar4: knob arp_mode 0 .. 3 at 10 17 size 2 2 "up · down · both · random"
widget n1: step s_n1 s_i 55 .. 880 at 2 13 size 1 5 "1"
widget n2: step s_n2 s_i 55 .. 880 at 3 13 size 1 5 "2"
widget n3: step s_n3 s_i 55 .. 880 at 4 13 size 1 5 "3"
widget n4: step s_n4 s_i 55 .. 880 at 5 13 size 1 5 "4"
widget n5: step s_n5 s_i 55 .. 880 at 6 13 size 1 5 "5"
widget n6: step s_n6 s_i 55 .. 880 at 7 13 size 1 5 "6"
widget n7: step s_n7 s_i 55 .. 880 at 8 13 size 1 5 "7"
widget n8: step s_n8 s_i 55 .. 880 at 9 13 size 1 5 "8"
widget pr: roll at 0 19 size 12 3 "what she plays, and what she hears the human play"
widget kb: keys pitch hold at 0 22 size 12 2 "keys (the computer's row of A on QWERTY, of Q on AZERTY · Z X, W X on AZERTY: octave)"
