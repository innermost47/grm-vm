# A low-frequency oscillator: a slow wave that moves other knobs by itself (the filter breathing, a vibrato, a
# tremolo). A triangle climbs and falls between -1 and 1 ({name}_t), its direction ({name}_d, 1 or -1) is a square
# wave already; the triangle bent by 1.5 t - 0.5 t^3 is almost a sine (it flattens where it turns). {name}_out goes
# from the smooth wave ({shape} 0) to the square ({shape} 1). {step}: how far the triangle goes at each sample
# (4 x frequency / 48 000).
network lfo(name, step, shape)
  var {name}_t = 0
  var {name}_d = 1
  set {name}_t = {name}_t + {step} * {name}_d
  set {name}_d = -1 when {name}_t in 1 .. 3
  set {name}_d = 1 when {name}_t in -3 .. -1
  node {name}_sine signed
  relate {name}_bend: {name}_sine = 1.5 * {name}_t - 0.5 * {name}_t ^ 3
  node {name}_out signed
  relate {name}_shape: {name}_out = {name}_sine + {shape} * {name}_d - {shape} * {name}_sine
end
