  set {name}_t_g = {name}_t_s17 when {clock_f} in -1 .. 0.5 and {name}_pos in 15.5 .. 16.5
  set {name}_t_g = {name}_t_s18 when {clock_f} in -1 .. 0.5 and {name}_pos in 16.5 .. 17.5
  set {name}_t_g = {name}_t_s19 when {clock_f} in -1 .. 0.5 and {name}_pos in 17.5 .. 18.5
  set {name}_t_g = {name}_t_s20 when {clock_f} in -1 .. 0.5 and {name}_pos in 18.5 .. 19.5
  set {name}_t_g = {name}_t_s21 when {clock_f} in -1 .. 0.5 and {name}_pos in 19.5 .. 20.5
  set {name}_t_g = {name}_t_s22 when {clock_f} in -1 .. 0.5 and {name}_pos in 20.5 .. 21.5
  set {name}_t_g = {name}_t_s23 when {clock_f} in -1 .. 0.5 and {name}_pos in 21.5 .. 22.5
  set {name}_t_g = {name}_t_s24 when {clock_f} in -1 .. 0.5 and {name}_pos in 22.5 .. 23.5
  set {name}_t_g = {name}_t_s25 when {clock_f} in -1 .. 0.5 and {name}_pos in 23.5 .. 24.5
  set {name}_t_g = {name}_t_s26 when {clock_f} in -1 .. 0.5 and {name}_pos in 24.5 .. 25.5
  set {name}_t_g = {name}_t_s27 when {clock_f} in -1 .. 0.5 and {name}_pos in 25.5 .. 26.5
  set {name}_t_g = {name}_t_s28 when {clock_f} in -1 .. 0.5 and {name}_pos in 26.5 .. 27.5
  set {name}_t_g = {name}_t_s29 when {clock_f} in -1 .. 0.5 and {name}_pos in 27.5 .. 28.5
  set {name}_t_g = {name}_t_s30 when {clock_f} in -1 .. 0.5 and {name}_pos in 28.5 .. 29.5
  set {name}_t_g = {name}_t_s31 when {clock_f} in -1 .. 0.5 and {name}_pos in 29.5 .. 30.5
  set {name}_t_g = {name}_t_s32 when {clock_f} in -1 .. 0.5 and {name}_pos in 30.5 .. 31.5
  set {name}_t_g = 0 when {clock_f} in 0.5 .. 3
  node {name}_t_gate signed
  # her hand on it, when it is hers: she strikes it as the human strikes its pad
  node {name}_t_p signed
  relate {name}_t_hand: {name}_t_p = {name}_t_pad + {name}_t_hers * {her_t}
  relate {name}_t_trig: {name}_t_gate = {name}_t_g + {name}_t_p - {name}_t_g * {name}_t_p
  node {name}_t_dr
  relate {name}_t_decay_rate: {name}_t_dr * {name}_t_decay = 0.0000208333333
  call adsr(name={name}_t_e, gate={name}_t_gate, attack=0.2, decay={name}_t_dr, sustain=0, release={name}_t_dr)
  call noise(name={name}_nz, seed=0.29)
  # the kick and the tom: a sine whose pitch falls with a quick envelope
  call adsr(name={name}_kp, gate={name}_k_gate, attack=0.3, decay=0.0006, sustain=0, release=0.0006)
  node {name}_k_step signed
  relate {name}_k_bend: {name}_k_step = 0.0000833333333 * {name}_k_tune + 0.000333333333 * {name}_k_tune * {name}_kp_e
  call lfo(name={name}_k_osc, step={name}_k_step, shape=0)
  call adsr(name={name}_tp, gate={name}_t_gate, attack=0.3, decay=0.0004, sustain=0, release=0.0004)
  node {name}_t_step signed
  relate {name}_t_bend: {name}_t_step = 0.0000833333333 * {name}_t_tune + 0.0000833333333 * {name}_t_tune * {name}_tp_e
  call lfo(name={name}_t_osc, step={name}_t_step, shape=0)
  # the snare: a tone and noise
  node {name}_s_step signed
  relate {name}_s_speed: {name}_s_step = 0.0000833333333 * {name}_s_tune
  call lfo(name={name}_s_osc, step={name}_s_step, shape=0)
  # the hi-hat: noise without its low part (the noise less what a slow follower of it keeps)
  var {name}_h_lp = 0
  set {name}_h_lp = {name}_h_lp + 0.25 * {name}_nz_out - 0.25 * {name}_h_lp
  node {name}_h_hp signed
  relate {name}_h_high: {name}_h_hp = {name}_nz_out - {name}_h_lp
  node {name}_out signed
  relate {name}_sum: {name}_out = {name}_k_level * {name}_k_e_e * {name}_k_osc_out + 0.4 * {name}_s_level * {name}_s_e_e * {name}_s_osc_out + 0.8 * {name}_s_level * {name}_s_e_e * {name}_nz_out + {name}_h_level * {name}_h_e_e * {name}_h_hp + {name}_t_level * {name}_t_e_e * {name}_t_osc_out
  hand kick when {name}_k_hers: {name}_k_pad
  hand snare when {name}_s_hers: {name}_s_pad
  hand hat when {name}_h_hers: {name}_h_pad
  hand tom when {name}_t_hers: {name}_t_pad
end
