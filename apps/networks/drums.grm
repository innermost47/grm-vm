# A drum machine of four instruments for the studio: a kick (a sine whose pitch falls fast), a snare (a tone and
# noise), a hi-hat (noise, its low part taken away), a tom (a sine, a little fall). Each its thirty-two steps on the
# transport, two bars ({name}_X_s1 .. s32: 1 plays; {name}_long at 0: one bar of sixteen, played again), its pad (the human's hand: 1 while pressed), its level, its pitch and
# its decay (seconds); each its own hand for her ({name}_X_hers): she strikes it ({her_k} .. {her_t}). Its sound: {name}_out.
# Needs: lfo, adsr, noise.
network drums(name, clock_i, clock_f, clock_h, her_k, her_s, her_h, her_t)
  # where it is in its two bars: the sixteenth of the bar, and of the second one when it is long
  input {name}_long = 1
  node {name}_pos signed
  relate {name}_where: {name}_pos = {clock_i} + 16 * {clock_h} * {name}_long
  input {name}_k_hers = 0
  # a drum given to her: she strikes it, and she turns its sound too (its pitch, its decay), two things at most at once
  hand turn_kick when {name}_k_hers: {name}_k_tune {name}_k_decay
  hand turn_snare when {name}_s_hers: {name}_s_tune {name}_s_decay
  hand turn_hat when {name}_h_hers: {name}_h_tune {name}_h_decay
  hand turn_tom when {name}_t_hers: {name}_t_tune {name}_t_decay
  input {name}_k_pad = 0
  input {name}_k_level = 0.9
  input {name}_k_tune = 50 positive
  input {name}_k_decay = 0.35 positive
  input {name}_k_s1 = 1
  input {name}_k_s2 = 0
  input {name}_k_s3 = 0
  input {name}_k_s4 = 0
  input {name}_k_s5 = 1
  input {name}_k_s6 = 0
  input {name}_k_s7 = 0
  input {name}_k_s8 = 0
  input {name}_k_s9 = 1
  input {name}_k_s10 = 0
  input {name}_k_s11 = 0
  input {name}_k_s12 = 0
  input {name}_k_s13 = 1
  input {name}_k_s14 = 0
  input {name}_k_s15 = 0
  input {name}_k_s16 = 0
  input {name}_k_s17 = 1
  input {name}_k_s18 = 0
  input {name}_k_s19 = 0
  input {name}_k_s20 = 0
  input {name}_k_s21 = 1
  input {name}_k_s22 = 0
  input {name}_k_s23 = 0
  input {name}_k_s24 = 0
  input {name}_k_s25 = 1
  input {name}_k_s26 = 0
  input {name}_k_s27 = 0
  input {name}_k_s28 = 0
  input {name}_k_s29 = 1
  input {name}_k_s30 = 0
  input {name}_k_s31 = 0
  input {name}_k_s32 = 0
  var {name}_k_g = 0
  set {name}_k_g = {name}_k_s1 when {clock_f} in -1 .. 0.5 and {name}_pos in -0.5 .. 0.5
  set {name}_k_g = {name}_k_s2 when {clock_f} in -1 .. 0.5 and {name}_pos in 0.5 .. 1.5
  set {name}_k_g = {name}_k_s3 when {clock_f} in -1 .. 0.5 and {name}_pos in 1.5 .. 2.5
  set {name}_k_g = {name}_k_s4 when {clock_f} in -1 .. 0.5 and {name}_pos in 2.5 .. 3.5
  set {name}_k_g = {name}_k_s5 when {clock_f} in -1 .. 0.5 and {name}_pos in 3.5 .. 4.5
  set {name}_k_g = {name}_k_s6 when {clock_f} in -1 .. 0.5 and {name}_pos in 4.5 .. 5.5
  set {name}_k_g = {name}_k_s7 when {clock_f} in -1 .. 0.5 and {name}_pos in 5.5 .. 6.5
  set {name}_k_g = {name}_k_s8 when {clock_f} in -1 .. 0.5 and {name}_pos in 6.5 .. 7.5
  set {name}_k_g = {name}_k_s9 when {clock_f} in -1 .. 0.5 and {name}_pos in 7.5 .. 8.5
  set {name}_k_g = {name}_k_s10 when {clock_f} in -1 .. 0.5 and {name}_pos in 8.5 .. 9.5
  set {name}_k_g = {name}_k_s11 when {clock_f} in -1 .. 0.5 and {name}_pos in 9.5 .. 10.5
  set {name}_k_g = {name}_k_s12 when {clock_f} in -1 .. 0.5 and {name}_pos in 10.5 .. 11.5
  set {name}_k_g = {name}_k_s13 when {clock_f} in -1 .. 0.5 and {name}_pos in 11.5 .. 12.5
  set {name}_k_g = {name}_k_s14 when {clock_f} in -1 .. 0.5 and {name}_pos in 12.5 .. 13.5
  set {name}_k_g = {name}_k_s15 when {clock_f} in -1 .. 0.5 and {name}_pos in 13.5 .. 14.5
  set {name}_k_g = {name}_k_s16 when {clock_f} in -1 .. 0.5 and {name}_pos in 14.5 .. 15.5
  set {name}_k_g = {name}_k_s17 when {clock_f} in -1 .. 0.5 and {name}_pos in 15.5 .. 16.5
  set {name}_k_g = {name}_k_s18 when {clock_f} in -1 .. 0.5 and {name}_pos in 16.5 .. 17.5
  set {name}_k_g = {name}_k_s19 when {clock_f} in -1 .. 0.5 and {name}_pos in 17.5 .. 18.5
  set {name}_k_g = {name}_k_s20 when {clock_f} in -1 .. 0.5 and {name}_pos in 18.5 .. 19.5
  set {name}_k_g = {name}_k_s21 when {clock_f} in -1 .. 0.5 and {name}_pos in 19.5 .. 20.5
  set {name}_k_g = {name}_k_s22 when {clock_f} in -1 .. 0.5 and {name}_pos in 20.5 .. 21.5
  set {name}_k_g = {name}_k_s23 when {clock_f} in -1 .. 0.5 and {name}_pos in 21.5 .. 22.5
  set {name}_k_g = {name}_k_s24 when {clock_f} in -1 .. 0.5 and {name}_pos in 22.5 .. 23.5
  set {name}_k_g = {name}_k_s25 when {clock_f} in -1 .. 0.5 and {name}_pos in 23.5 .. 24.5
  set {name}_k_g = {name}_k_s26 when {clock_f} in -1 .. 0.5 and {name}_pos in 24.5 .. 25.5
  set {name}_k_g = {name}_k_s27 when {clock_f} in -1 .. 0.5 and {name}_pos in 25.5 .. 26.5
  set {name}_k_g = {name}_k_s28 when {clock_f} in -1 .. 0.5 and {name}_pos in 26.5 .. 27.5
  set {name}_k_g = {name}_k_s29 when {clock_f} in -1 .. 0.5 and {name}_pos in 27.5 .. 28.5
  set {name}_k_g = {name}_k_s30 when {clock_f} in -1 .. 0.5 and {name}_pos in 28.5 .. 29.5
  set {name}_k_g = {name}_k_s31 when {clock_f} in -1 .. 0.5 and {name}_pos in 29.5 .. 30.5
  set {name}_k_g = {name}_k_s32 when {clock_f} in -1 .. 0.5 and {name}_pos in 30.5 .. 31.5
  set {name}_k_g = 0 when {clock_f} in 0.5 .. 3
  node {name}_k_gate signed
  # her hand on it, when it is hers: she strikes it as the human strikes its pad
  node {name}_k_p signed
  relate {name}_k_hand: {name}_k_p = {name}_k_pad + {name}_k_hers * {her_k}
  relate {name}_k_trig: {name}_k_gate = {name}_k_g + {name}_k_p - {name}_k_g * {name}_k_p
  node {name}_k_dr
  relate {name}_k_decay_rate: {name}_k_dr * {name}_k_decay = 0.0000208333333
  call adsr(name={name}_k_e, gate={name}_k_gate, attack=0.2, decay={name}_k_dr, sustain=0, release={name}_k_dr)
