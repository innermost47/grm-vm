# A sequencer of eight steps, a network apart that drives an instrument: a clock that turns ({rate}: steps a
# second / 48 000), the step it is on ({name}_i, 0 to 7), a gate open the first half of each step ({name}_gate),
# and the pitch of the step ({name}_pitch), read from the nodes {name}_n1 .. {name}_n8.
network sequencer(name, rate)
  var {name}_ph = 0
  set {name}_ph = {name}_ph + {rate} when {name}_ph in -1 .. 1
  set {name}_ph = {name}_ph + {rate} - 1 when {name}_ph in 1 .. 3
  var {name}_i = 0
  set {name}_i = {name}_i + 1 when {name}_ph in 1 .. 3
  set {name}_i = 0 when {name}_ph in 1 .. 3 and {name}_i in 6.5 .. 9
  var {name}_gate = 0
  set {name}_gate = 1 when {name}_ph in 0 .. 0.5
  set {name}_gate = 0 when {name}_ph in 0.5 .. 3
  var {name}_pitch = 220
  set {name}_pitch = {name}_n1 when {name}_i in -0.5 .. 0.5
  set {name}_pitch = {name}_n2 when {name}_i in 0.5 .. 1.5
  set {name}_pitch = {name}_n3 when {name}_i in 1.5 .. 2.5
  set {name}_pitch = {name}_n4 when {name}_i in 2.5 .. 3.5
  set {name}_pitch = {name}_n5 when {name}_i in 3.5 .. 4.5
  set {name}_pitch = {name}_n6 when {name}_i in 4.5 .. 5.5
  set {name}_pitch = {name}_n7 when {name}_i in 5.5 .. 6.5
  set {name}_pitch = {name}_n8 when {name}_i in 6.5 .. 7.5
end
