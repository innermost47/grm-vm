# The transport: one clock for the whole studio. {step}: how far it goes at each sample (sixteenths a second /
# 48 000); {run}: 1 while it plays, 0 stopped. {name}_f goes from 0 to 1 within each sixteenth, {name}_i counts the
# sixteenths of the bar (0 .. 15), {name}_bar the bars, {name}_h which of two bars (0, 1). Every instrument reads it: they are in time together.
# {name}_click is the metronome: a click on each beat, the first of the bar louder.
network transport(name, step, run)
  var {name}_f = 0
  set {name}_f = {name}_f + {step} * {run} when {name}_f in -1 .. 1
  set {name}_f = {name}_f + {step} * {run} - 1 when {name}_f in 1 .. 3
  var {name}_i = 0
  set {name}_i = {name}_i + 1 when {name}_f in 1 .. 3 and {name}_i in -1 .. 14.5
  set {name}_i = 0 when {name}_f in 1 .. 3 and {name}_i in 14.5 .. 99
  # the bars: circles within circles, as a clock's hands (nothing counts on without end: sixteen bars make a turn,
  # which moves the circle above it by one, as the minutes move the hour). 16 x 16 x 16 x 16 bars, and round again
  var {name}_bar = 0
  set {name}_bar = {name}_bar + 1 when {name}_f in 1 .. 3 and {name}_i in 14.5 .. 99 and {name}_bar in -1 .. 14.5
  set {name}_bar = 0 when {name}_f in 1 .. 3 and {name}_i in 14.5 .. 99 and {name}_bar in 14.5 .. 99
  var {name}_bar2 = 0
  set {name}_bar2 = {name}_bar2 + 1 when {name}_f in 1 .. 3 and {name}_i in 14.5 .. 99 and {name}_bar in 14.5 .. 99 and {name}_bar2 in -1 .. 14.5
  set {name}_bar2 = 0 when {name}_f in 1 .. 3 and {name}_i in 14.5 .. 99 and {name}_bar in 14.5 .. 99 and {name}_bar2 in 14.5 .. 99
  var {name}_bar3 = 0
  set {name}_bar3 = {name}_bar3 + 1 when {name}_f in 1 .. 3 and {name}_i in 14.5 .. 99 and {name}_bar in 14.5 .. 99 and {name}_bar2 in 14.5 .. 99 and {name}_bar3 in -1 .. 14.5
  set {name}_bar3 = 0 when {name}_f in 1 .. 3 and {name}_i in 14.5 .. 99 and {name}_bar in 14.5 .. 99 and {name}_bar2 in 14.5 .. 99 and {name}_bar3 in 14.5 .. 99
  var {name}_bar4 = 0
  set {name}_bar4 = {name}_bar4 + 1 when {name}_f in 1 .. 3 and {name}_i in 14.5 .. 99 and {name}_bar in 14.5 .. 99 and {name}_bar2 in 14.5 .. 99 and {name}_bar3 in 14.5 .. 99 and {name}_bar4 in -1 .. 14.5
  set {name}_bar4 = 0 when {name}_f in 1 .. 3 and {name}_i in 14.5 .. 99 and {name}_bar in 14.5 .. 99 and {name}_bar2 in 14.5 .. 99 and {name}_bar3 in 14.5 .. 99 and {name}_bar4 in 14.5 .. 99
  # every one of them on its dial (its rail twice its turn: exact all the way round)
  rail {name}_bar 32
  rail {name}_bar2 32
  rail {name}_bar3 32
  rail {name}_bar4 32
  # where it is, as a human counts: the bar (from 1), the beat in it (1 .. 4)
  var {name}_beat = 0
  set {name}_beat = {name}_beat + 1 when {name}_f in 1 .. 3 and {name}_i in 2.5 .. 3.5
  set {name}_beat = {name}_beat + 1 when {name}_f in 1 .. 3 and {name}_i in 6.5 .. 7.5
  set {name}_beat = {name}_beat + 1 when {name}_f in 1 .. 3 and {name}_i in 10.5 .. 11.5
  set {name}_beat = 0 when {name}_f in 1 .. 3 and {name}_i in 14.5 .. 99
  rail {name}_beat 8
  node {name}_beats
  relate {name}_beat_counted: {name}_beats = {name}_beat + 1
  node {name}_bars
  relate {name}_bars_counted: {name}_bars = 4096 * {name}_bar4 + 256 * {name}_bar3 + 16 * {name}_bar2 + {name}_bar + 1
  var {name}_h = 0
  set {name}_h = 1 - {name}_h when {name}_f in 1 .. 3 and {name}_i in 14.5 .. 99
  var {name}_e = 0
  set {name}_e = 1 when {name}_f in 1 .. 3 and {name}_i in 14.5 .. 99
  set {name}_e = 0.55 when {name}_f in 1 .. 3 and {name}_i in 2.5 .. 3.5
  set {name}_e = 0.55 when {name}_f in 1 .. 3 and {name}_i in 6.5 .. 7.5
  set {name}_e = 0.55 when {name}_f in 1 .. 3 and {name}_i in 10.5 .. 11.5
  set {name}_e = 0.9985 * {name}_e when {name}_f in -1 .. 1
  call lfo(name={name}_tone, step=0.125, shape=0)
  node {name}_click signed
  relate {name}_clicking: {name}_click = {name}_e * {name}_tone_out
end
