app Studio
icon audio-lines
# Written by the studio from its song: its tracks are changed there (+ synth, + drums), not here.
# Song: first song
input bpm = 120 positive
input playing = 1
input metro_on = 0
input metro_level = 0.3
input master = 0.8
input echo_back = 0.35
input echo_return = 0.5
input room = 0.75
input rev_return = 0.6
set elle_ctx_song = 1
set elle_ctx_human = 1
input elle_lessons_on = 1
set elle_lessons = 28 * elle_lessons_on
input elle_lesson_pick = 0
set elle_lesson = elle_lesson_pick when elle_lesson_pick in 0.5 .. 999
input elle_key_pick = -1
set elle_keypick = elle_key_pick
node tr_step
relate sixteenths: tr_step = 0.00000138888889 * bpm
use networks/lfo.grm
use networks/saw.grm
use networks/square.grm
use networks/ladder.grm
use networks/adsr.grm
use networks/noise.grm
use networks/voice.grm
use networks/transport.grm
use networks/arpeggiator.grm
use networks/synth.grm
use networks/drums.grm
use networks/echo.grm
use networks/reverb.grm
call transport(name=tr, step=tr_step, run=playing)
set elle_clock_i = tr_i
set elle_clock_f = tr_f
node elle_sounding signed
relate elle_while_playing: elle_sounding = playing * elle_gate
node elle_bsounding signed
relate elle_bass_while_playing: elle_bsounding = playing * elle_bgate
node elle_hsounding signed
relate elle_harm_while_playing: elle_hsounding = playing * elle_hgate
node elle_strike1 signed
relate elle_strike_while1: elle_strike1 = playing * elle_dhit1
node elle_strike2 signed
relate elle_strike_while2: elle_strike2 = playing * elle_dhit2
node elle_strike3 signed
relate elle_strike_while3: elle_strike3 = playing * elle_dhit3
node elle_strike4 signed
relate elle_strike_while4: elle_strike4 = playing * elle_dhit4
call synth(name=t1, clock_i=tr_i, clock_f=tr_f, hers=0, her_pitch=elle_pitch, her_gate=elle_sounding, her_bass=elle_bpitch, her_bass_gate=elle_bsounding, her_harm=elle_hpitch, her_harm_gate=elle_hsounding, her_tone=elle_tone)
input t1_level = 0.6
input t1_pan = 0.42
input t1_echo = 0.2
input t1_rev = 0.25
input t1_on = 1
node t1_l signed
relate t1_left: t1_l = 1.4 * t1_on * t1_level * t1_out - 1.4 * t1_on * t1_level * t1_pan * t1_out
node t1_r signed
relate t1_right: t1_r = 1.4 * t1_on * t1_level * t1_pan * t1_out
call synth(name=t2, clock_i=tr_i, clock_f=tr_f, hers=1, her_pitch=elle_pitch, her_gate=elle_sounding, her_bass=elle_bpitch, her_bass_gate=elle_bsounding, her_harm=elle_hpitch, her_harm_gate=elle_hsounding, her_tone=elle_tone)
input t2_level = 0.6
input t2_pan = 0.62
input t2_echo = 0.2
input t2_rev = 0.25
input t2_on = 1
node t2_l signed
relate t2_left: t2_l = 1.4 * t2_on * t2_level * t2_out - 1.4 * t2_on * t2_level * t2_pan * t2_out
node t2_r signed
relate t2_right: t2_r = 1.4 * t2_on * t2_level * t2_pan * t2_out
call drums(name=t3, clock_i=tr_i, clock_f=tr_f, clock_h=tr_h, her_k=elle_strike1, her_s=elle_strike2, her_h=elle_strike3, her_t=elle_strike4)
input t3_level = 0.9
input t3_pan = 0.42
input t3_echo = 0
input t3_rev = 0.08
input t3_on = 1
node t3_l signed
relate t3_left: t3_l = 1.4 * t3_on * t3_level * t3_out - 1.4 * t3_on * t3_level * t3_pan * t3_out
node t3_r signed
relate t3_right: t3_r = 1.4 * t3_on * t3_level * t3_pan * t3_out
# lesson 1: one note, one a beat
set elle_open8 = 1 when elle_lesson in 0.5 .. 1.5 and elle_lessons in 0.5 .. 999
set elle_open16 = 1 when elle_lesson in 0.5 .. 1.5 and elle_lessons in 0.5 .. 999
set elle_beats = 1 when elle_lesson in 0.5 .. 1.5 and elle_lessons in 0.5 .. 999
set elle_quarter = 1 when elle_lesson in 0.5 .. 1.5 and elle_lessons in 0.5 .. 999
set elle_breathw = 0.2 when elle_lesson in 0.5 .. 1.5 and elle_lessons in 0.5 .. 999
repeat p in 0 .. 11: set elle_sc{p} = 0 when elle_lesson in 0.5 .. 1.5 and elle_lessons in 0.5 .. 999
set elle_sc0 = 1 when elle_lesson in 0.5 .. 1.5 and elle_lessons in 0.5 .. 999
# lesson 2: a tone
set elle_open6 = 1 when elle_lesson in 1.5 .. 2.5 and elle_lessons in 0.5 .. 999
set elle_open8 = 1 when elle_lesson in 1.5 .. 2.5 and elle_lessons in 0.5 .. 999
set elle_open10 = 1 when elle_lesson in 1.5 .. 2.5 and elle_lessons in 0.5 .. 999
set elle_open16 = 1 when elle_lesson in 1.5 .. 2.5 and elle_lessons in 0.5 .. 999
set elle_beats = 1 when elle_lesson in 1.5 .. 2.5 and elle_lessons in 0.5 .. 999
set elle_quarter = 1 when elle_lesson in 1.5 .. 2.5 and elle_lessons in 0.5 .. 999
set elle_breathw = 0.4 when elle_lesson in 1.5 .. 2.5 and elle_lessons in 0.5 .. 999
repeat p in 0 .. 11: set elle_sc{p} = 0 when elle_lesson in 1.5 .. 2.5 and elle_lessons in 0.5 .. 999
set elle_sc0 = 1 when elle_lesson in 1.5 .. 2.5 and elle_lessons in 0.5 .. 999
set elle_sc2 = 1 when elle_lesson in 1.5 .. 2.5 and elle_lessons in 0.5 .. 999
# lesson 3: the pentatonic
repeat k in 5 .. 11: set elle_open{k} = 1 when elle_lesson in 2.5 .. 3.5 and elle_lessons in 0.5 .. 999
set elle_open16 = 1 when elle_lesson in 2.5 .. 3.5 and elle_lessons in 0.5 .. 999
set elle_breathw = 0.5 when elle_lesson in 2.5 .. 3.5 and elle_lessons in 0.5 .. 999
repeat p in 0 .. 11: set elle_sc{p} = 0 when elle_lesson in 2.5 .. 3.5 and elle_lessons in 0.5 .. 999
set elle_sc0 = 1 when elle_lesson in 2.5 .. 3.5 and elle_lessons in 0.5 .. 999
set elle_sc2 = 1 when elle_lesson in 2.5 .. 3.5 and elle_lessons in 0.5 .. 999
set elle_sc4 = 1 when elle_lesson in 2.5 .. 3.5 and elle_lessons in 0.5 .. 999
set elle_sc7 = 1 when elle_lesson in 2.5 .. 3.5 and elle_lessons in 0.5 .. 999
set elle_sc9 = 1 when elle_lesson in 2.5 .. 3.5 and elle_lessons in 0.5 .. 999
# lesson 4: the major scale
repeat k in 4 .. 12: set elle_open{k} = 1 when elle_lesson in 3.5 .. 4.5 and elle_lessons in 0.5 .. 999
set elle_open16 = 1 when elle_lesson in 3.5 .. 4.5 and elle_lessons in 0.5 .. 999
set elle_breathw = 0.6 when elle_lesson in 3.5 .. 4.5 and elle_lessons in 0.5 .. 999
repeat p in 0 .. 11: set elle_sc{p} = 0 when elle_lesson in 3.5 .. 4.5 and elle_lessons in 0.5 .. 999
set elle_sc0 = 1 when elle_lesson in 3.5 .. 4.5 and elle_lessons in 0.5 .. 999
set elle_sc2 = 1 when elle_lesson in 3.5 .. 4.5 and elle_lessons in 0.5 .. 999
set elle_sc4 = 1 when elle_lesson in 3.5 .. 4.5 and elle_lessons in 0.5 .. 999
set elle_sc5 = 1 when elle_lesson in 3.5 .. 4.5 and elle_lessons in 0.5 .. 999
set elle_sc7 = 1 when elle_lesson in 3.5 .. 4.5 and elle_lessons in 0.5 .. 999
set elle_sc9 = 1 when elle_lesson in 3.5 .. 4.5 and elle_lessons in 0.5 .. 999
set elle_sc11 = 1 when elle_lesson in 3.5 .. 4.5 and elle_lessons in 0.5 .. 999
# lesson 5: fourths and fifths
set elle_open1 = 1 when elle_lesson in 4.5 .. 5.5 and elle_lessons in 0.5 .. 999
repeat k in 3 .. 13: set elle_open{k} = 1 when elle_lesson in 4.5 .. 5.5 and elle_lessons in 0.5 .. 999
set elle_open15 = 1 when elle_lesson in 4.5 .. 5.5 and elle_lessons in 0.5 .. 999
set elle_open16 = 1 when elle_lesson in 4.5 .. 5.5 and elle_lessons in 0.5 .. 999
