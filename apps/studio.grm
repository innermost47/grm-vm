repeat p in 0 .. 11: set elle_sc{p} = 0 when elle_lesson in 4.5 .. 5.5 and elle_lessons in 0.5 .. 999
set elle_sc0 = 1 when elle_lesson in 4.5 .. 5.5 and elle_lessons in 0.5 .. 999
