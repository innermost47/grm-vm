node echo_in signed
relate echo_send: echo_in = t1_echo * t1_on * t1_out + t2_echo * t2_on * t2_out + t3_echo * t3_on * t3_out
call echo(name=fxe, input=echo_in, time=0.3750, feedback=echo_back)
node rev_in signed
relate rev_send: rev_in = t1_rev * t1_on * t1_out + t2_rev * t2_on * t2_out + t3_rev * t3_on * t3_out + 0.3 * fxe_wet
call reverb(name=fxr, input=rev_in, decay=room)
node out signed
rail out 16
relate master_left: out = master * t1_l + master * t2_l + master * t3_l + master * echo_return * fxe_wet + master * rev_return * fxr_out + metro_on * metro_level * tr_click
node out_r signed
relate master_right: out_r = master * t1_r + master * t2_r + master * t3_r + master * echo_return * fxe_wet + master * rev_return * fxr_out + metro_on * metro_level * tr_click
rail out_r 16
