set elle_ct11 = 1 when elle_lesson in 6.5 .. 7.5 and elle_lessons in 0.5 .. 999 and elle_bar in 0.5 .. 1.5
set elle_root = 7 when elle_lesson in 6.5 .. 7.5 and elle_lessons in 0.5 .. 999 and elle_bar in 0.5 .. 1.5
repeat p in 0 .. 11: set elle_ct{p} = 0 when elle_lesson in 6.5 .. 7.5 and elle_lessons in 0.5 .. 999 and elle_bar in 1.5 .. 2.5
