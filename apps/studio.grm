set elle_sc11 = 1 when elle_lesson in 6.5 .. 7.5 and elle_lessons in 0.5 .. 999
repeat p in 0 .. 11: set elle_ct{p} = 0 when elle_lesson in 6.5 .. 7.5 and elle_lessons in 0.5 .. 999 and elle_bar in -0.5 .. 0.5
set elle_ct0 = 1 when elle_lesson in 6.5 .. 7.5 and elle_lessons in 0.5 .. 999 and elle_bar in -0.5 .. 0.5
set elle_ct4 = 1 when elle_lesson in 6.5 .. 7.5 and elle_lessons in 0.5 .. 999 and elle_bar in -0.5 .. 0.5
set elle_ct7 = 1 when elle_lesson in 6.5 .. 7.5 and elle_lessons in 0.5 .. 999 and elle_bar in -0.5 .. 0.5
set elle_root = 0 when elle_lesson in 6.5 .. 7.5 and elle_lessons in 0.5 .. 999 and elle_bar in -0.5 .. 0.5
repeat p in 0 .. 11: set elle_ct{p} = 0 when elle_lesson in 6.5 .. 7.5 and elle_lessons in 0.5 .. 999 and elle_bar in 0.5 .. 1.5
