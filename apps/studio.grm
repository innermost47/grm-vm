app Studio
icon audio-lines
# The studio: its song is this file. Its tracks are its lists (+ synth, + drums grow them); each list makes its
# instruments' networks, their panels, their strips on the mixer, and the mix.

# its tracks: the human's synthesisers, hers, the drum machines
list my_synths = t1
list her_synths = t2
list synths = my_synths her_synths
list drums = t3
list tracks = synths drums

# the time, the master
input bpm = 120 positive
input playing = 1
input metro_on = 0
input metro_level = 0.3
input master = 0.8
input echo_beats = 0.75
input echo_back = 0.35
input echo_return = 0.5
input room = 0.75
input rev_return = 0.6

# her: this song (what she learned in each is kept apart; who plays with her, the window tells her), her lessons
# (each said while it is hers: the one the human gives her, else she goes from one to the next by herself), a key
set elle_ctx_song = 1
list lessons = 01_one_note 02_a_tone 03_pentatonic 04_major 05_fourths_and_fifths 06_minor 07_four_chords 08_dorian 09_phrygian 10_lydian 11_mixolydian 12_blues 13_two_five_one 14_minor_two_five_one 15_andalusian 16_hijaz 17_bhairav 18_in 19_pelog 20_whole_tone 21_modes 22_by_fifths 23_keys 24_mode_and_key 25_two_fives_down 26_coltrane 27_twelve_tones 28_her_ears
input elle_lessons_on = 1
set elle_lessons = sum(l in lessons: 1) * elle_lessons_on
input elle_lesson_pick = 0
set elle_lesson = elle_lesson_pick when elle_lesson_pick in 0.5 .. 999
input elle_key_pick = -1
set elle_keypick = elle_key_pick
repeat l in lessons: use ../mind/lessons/{l}.grm (name=elle, here=elle_lesson in {l.i}.5 .. {l.k}.5 and elle_lessons in 0.5 .. 999)

node tr_step
relate sixteenths: tr_step = 0.00000138888889 * bpm
use networks/lfo.grm
use networks/saw.grm
use networks/square.grm
use networks/ladder.grm
use networks/adsr.grm
use networks/noise.grm
use networks/voice.grm
use networks/transport.grm
use networks/arpeggiator.grm
use networks/synth.grm
use networks/drums.grm
use networks/echo.grm
use networks/reverb.grm
call transport(name=tr, step=tr_step, run=playing)
set elle_clock_i = tr_i
set elle_clock_f = tr_f
node elle_sounding signed
relate elle_while_playing: elle_sounding = playing * elle_gate
node elle_bsounding signed
relate elle_bass_while_playing: elle_bsounding = playing * elle_bgate
node elle_hsounding signed
relate elle_harm_while_playing: elle_hsounding = playing * elle_hgate
node elle_strike1 signed
relate elle_strike_while1: elle_strike1 = playing * elle_dhit1
node elle_strike2 signed
relate elle_strike_while2: elle_strike2 = playing * elle_dhit2
node elle_strike3 signed
relate elle_strike_while3: elle_strike3 = playing * elle_dhit3
node elle_strike4 signed
relate elle_strike_while4: elle_strike4 = playing * elle_dhit4

# the instruments: each track's network
repeat t in my_synths: call synth(name={t}, clock_i=tr_i, clock_f=tr_f, hers=0, her_pitch=elle_pitch, her_gate=elle_sounding, her_bass=elle_bpitch, her_bass_gate=elle_bsounding, her_harm=elle_hpitch, her_harm_gate=elle_hsounding, her_tone=elle_tone)
repeat t in her_synths: call synth(name={t}, clock_i=tr_i, clock_f=tr_f, hers=1, her_pitch=elle_pitch, her_gate=elle_sounding, her_bass=elle_bpitch, her_bass_gate=elle_bsounding, her_harm=elle_hpitch, her_harm_gate=elle_hsounding, her_tone=elle_tone)
repeat t in drums: call drums(name={t}, clock_i=tr_i, clock_f=tr_f, clock_h=tr_h, her_k=elle_strike1, her_s=elle_strike2, her_h=elle_strike3, her_t=elle_strike4)

# each track's strip: level, pan (0 left .. 1 right), sends, on
# what she may turn on her synthesiser, part by part, given by the human (a `hand turn_...` each): she turns at most
# two things at once, keeps what pleases her, puts back what does not
repeat t in her_synths: input {t}_may_osc = 0
repeat t in her_synths: input {t}_may_filter = 0
repeat t in her_synths: input {t}_may_env = 0
repeat t in her_synths: input {t}_may_lfo = 0
repeat t in her_synths: input {t}_may_seq = 0
repeat t in her_synths: input {t}_may_arp = 0
repeat t in her_synths: hand turn_osc when {t}_may_osc: {t}_shape {t}_o1_level {t}_o2_level {t}_o2_ratio {t}_o3_level {t}_o3_ratio {t}_fm {t}_noise {t}_pitch_env
repeat t in her_synths: hand turn_filter when {t}_may_filter: {t}_cutoff {t}_env_amount {t}_resonance {t}_fa_time {t}_fd_time {t}_f_sustain {t}_fr_time
repeat t in her_synths: hand turn_env when {t}_may_env: {t}_aa_time {t}_ad_time {t}_a_sustain {t}_ar_time {t}_glide
repeat t in her_synths: hand turn_lfo when {t}_may_lfo: {t}_lfo_rate {t}_lfo_shape {t}_lfo_cut {t}_lfo_pitch {t}_lfo_amp
repeat t in her_synths: hand turn_seq when {t}_may_seq: {t}_seq_on {t}_s_n1 {t}_s_on1 {t}_s_n2 {t}_s_on2 {t}_s_n3 {t}_s_on3 {t}_s_n4 {t}_s_on4 {t}_s_n5 {t}_s_on5 {t}_s_n6 {t}_s_on6 {t}_s_n7 {t}_s_on7 {t}_s_n8 {t}_s_on8
repeat t in her_synths: hand turn_arp when {t}_may_arp: {t}_arp_on {t}_arp_latch {t}_arp_mode {t}_arp_oct {t}_arp_rate

repeat t in my_synths: input {t}_level = 0.6
repeat t in her_synths: input {t}_level = 0.6
repeat t in drums: input {t}_level = 0.9
repeat t in my_synths: input {t}_pan = 0.42
repeat t in her_synths: input {t}_pan = 0.62
repeat t in drums: input {t}_pan = 0.42
repeat t in synths: input {t}_echo = 0.2
repeat t in drums: input {t}_echo = 0
repeat t in synths: input {t}_rev = 0.25
repeat t in drums: input {t}_rev = 0.08
repeat t in tracks: input {t}_on = 1
repeat t in tracks: node {t}_l signed
repeat t in tracks: relate {t}_left: {t}_l = 1.4 * {t}_on * {t}_level * {t}_out - 1.4 * {t}_on * {t}_level * {t}_pan * {t}_out
repeat t in tracks: node {t}_r signed
repeat t in tracks: relate {t}_right: {t}_r = 1.4 * {t}_on * {t}_level * {t}_pan * {t}_out

# the sends: one echo (on the tempo: so many beats), one reverb, for every track
node echo_in signed
relate echo_send: echo_in = sum(t in tracks: {t}_echo * {t}_on * {t}_out)
node echo_time
relate echo_on_tempo: echo_time = 60 * echo_beats * bpm^-1
call echo(name=fxe, input=echo_in, time=echo_time up to 2, feedback=echo_back)
node rev_in signed
relate rev_send: rev_in = sum(t in tracks: {t}_rev * {t}_on * {t}_out) + 0.3 * fxe_wet
call reverb(name=fxr, input=rev_in, decay=room)
# the master's potential: what comes out is a unit or so; never the infinite, whatever happens upstream
node out signed
rail out 16
relate master_left: out = sum(t in tracks: master * {t}_l) + master * echo_return * fxe_wet + master * rev_return * fxr_out + metro_on * metro_level * tr_click
node out_r signed
rail out_r 16
relate master_right: out_r = sum(t in tracks: master * {t}_r) + master * echo_return * fxe_wet + master * rev_return * fxr_out + metro_on * metro_level * tr_click

# the surface: the transport, her, her lesson, what she plays, a track more, each instrument's panel, the mixer
use widgets/transport.grm
use widgets/her.grm
use widgets/synth.grm
use widgets/drums.grm
use widgets/mixer.grm
widget top: transport at 0 0
widget her: her_band at 0 1
widget lesson: choice elle_lesson_pick at 0 4 size 6 1 "lesson: hers=0|1 · one note, one a beat=1|2 · a tone=2|3 · the pentatonic=3|4 · the major scale=4|5 · fourths and fifths=5|6 · the minor scale=6|7 · four chords: I-V-vi-IV=7|8 · dorian over a vamp=8|9 · phrygian=9|10 · lydian=10|11 · mixolydian=11|12 · the blues=12|13 · ii-V-I=13|14 · minor ii-V-i=14|15 · the andalusian cadence=15|16 · hijaz=16|17 · bhairav=17|18 · the Japanese in=18|19 · pelog=19|20 · the whole tone=20|21 · the modes on one tonic=21|22 · the key moves by fifths=22|23 · the key moves=23|24 · mode and key at once=24|25 · ii-V's down by whole tones=25|26 · Coltrane's changes=26|27 · the twelve tones=27|28 · nothing but her ears=28" tip "the lesson she is given, or the one she is in"
widget roll: roll at 0 5 size 12 3 "what she plays"
widget add: row at 0 8 size 12 1
  widget synth: button "synth" icon plus say "list {app} my_synths add next" tip "a synthesiser more"
  widget drums: button "drum machine" icon plus say "list {app} drums add next" tip "a drum machine more"
end
widget body: column at 0 9
  repeat t in my_synths: widget {t}sec: synth_panel(t={t}, label=synth)
  repeat t in her_synths: widget {t}sec: synth_panel(t={t}, label=her synth)
  repeat t in her_synths: widget {t}may: her_rights(t={t})
  repeat t in drums: widget {t}sec: drums_panel(t={t}, label=drums)
  widget mixer: row size 12 7
    repeat t in my_synths: widget {t}mix: strip(ch={t}, label=synth)
    repeat t in her_synths: widget {t}mix: strip(ch={t}, label=her synth)
    repeat t in drums: widget {t}mix: strip(ch={t}, label=drums)
    widget out: master
  end
end
